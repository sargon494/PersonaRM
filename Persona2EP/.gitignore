.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (CLion, etc.)
.idea/
*.iml
*.iws
*.ipr

# Xcode
*.xcworkspace
*.xcodeproj
xcuserdata/

# Sublime Text
*.sublime-project
*.sublime-workspace

# ───────────────────────────────────────────────────────────────────────
