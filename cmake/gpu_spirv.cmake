# cmake -DSRC=gpu_renderer.cpp -DOUT=dir -DGLSLANG=glslangValidator -P gpu_spirv.cmake
# Compiles the GPU renderer's HLSL (the raw strings kShaderVs/Ps/Display in SRC, the same source D3D12
# compiles at run time) to SPIR-V for SDL_gpu's Vulkan backend: OUT/gpu_spirv.h with one uint32_t array
# per shader (<name>_spv). Generated at build time, never committed (docs/GPU_RENDERER.md).
file(READ "${SRC}" text)
set(header "// Generated by cmake/gpu_spirv.cmake from gpu_renderer.cpp. Do not edit.\n#pragma once\n")
foreach(pair "kShaderVs;vert" "kShaderPs;frag" "kShaderDisplay;frag")
    list(GET pair 0 name)
    list(GET pair 1 stage)
    string(FIND "${text}" "const char* ${name} = R\"(" begin)
    if(begin EQUAL -1)
        message(FATAL_ERROR "${name} not found in ${SRC}")
    endif()
    string(LENGTH "const char* ${name} = R\"(" skip)
    math(EXPR begin "${begin} + ${skip}")
    string(SUBSTRING "${text}" ${begin} -1 rest)
    string(FIND "${rest}" ")\";" end)
    string(SUBSTRING "${rest}" 0 ${end} hlsl)
    file(WRITE "${OUT}/${name}.hlsl" "${hlsl}")
    execute_process(
        COMMAND "${GLSLANG}" -D -V -S ${stage} -e main --vn ${name}_spv -o "${OUT}/${name}.h" "${OUT}/${name}.hlsl"
        RESULT_VARIABLE rc OUTPUT_VARIABLE log ERROR_VARIABLE log)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "glslangValidator failed on ${name}:\n${log}")
    endif()
    string(APPEND header "#include \"${name}.h\"\n")
endforeach()
file(WRITE "${OUT}/gpu_spirv.h" "${header}")
